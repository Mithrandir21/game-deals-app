<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container for the Waitlist deals widget's data (WaitlistWidgetExport.kt writes it, the widget reads it).
	     The group must be registered in the Apple Developer account and enabled on this target's App ID. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.pm.bam.gamedeals</string>
	</array>
	<!-- Universal Links for shared game and wishlist links (https://gamedeals.bam.pm/g/<id>, /w/<ids>; the paths are in
	     the Worker's apple-app-site-association). Associated Domains must be enabled on
	     this target's App ID, and the release profile regenerated, before a signed build can carry this. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:gamedeals.bam.pm</string>
	</array>
</dict>
</plist>
